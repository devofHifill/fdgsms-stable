# FDGSMS server environment variables — copy to .env and fill in.
# NEVER commit the real .env. This file documents the required keys only.

# --- Server ---
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database ---
MONGO_URI=mongodb://localhost:27017/fdgsms

# --- Auth (admin login) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- AI Reply System ---
# Optional: the API key can instead be set from the AI settings page (stored in
# AiSettings). If AiSettings.apiKey is blank, the AI service falls back to this.
OPENAI_API_KEY=
# Secret used to encrypt the AI provider key stored in the DB. Set a long random
# value in production; falls back to JWT_SECRET if unset. Changing it makes
# previously-encrypted keys unreadable (re-enter the key in settings).
AI_SECRET_KEY=
