# =========================================================
# FDGSMS — environment for docker-compose
# =========================================================
# Copy this file to `.env` next to docker-compose.yml on each
# server and fill in that server's real values.
#
#   cp .env.example .env && nano .env
#
# `.env` is git-ignored and must NEVER be committed.
# Every server (live, staging, local) keeps its own copy.
# =========================================================

# --- Site -------------------------------------------------
# Domain this environment is served on, no https:// prefix.
# live    -> fdgsms.filldesigngroup.cloud
# staging -> fdgsms.fillforge.cloud
APP_DOMAIN=

# --- Database ---------------------------------------------
# Must match the credentials the mongo_data volume was
# created with, or the server cannot authenticate.
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=fdgsms

# --- Auth -------------------------------------------------
# Long random string. Generate one with:
#   openssl rand -base64 36
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First admin account, created on startup if missing.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Twilio -----------------------------------------------
# Leave blank on any environment that must not send real SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- AI replies -------------------------------------------
# Optional. AI_SECRET_KEY encrypts keys stored in the database.
OPENAI_API_KEY=
AI_SECRET_KEY=
